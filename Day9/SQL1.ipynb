   "cell_type": "markdown",
   "source": [
    "\n",
    "        SELECT\n",
    "s.year,\n",
    "s.semester,\n",
    "COUNT(DISTINCT s.professor_id) AS no_of_professor\n",
    "FROM schedule AS s\n",
    "        JOIN course as c ON c.id = s.course_id\n",
    "        WHERE c.id BETWEEN 1 AND 10\n",
    "GROUP BY s.year, s.semester\n",
    "ORDER BY s.year ASC, s.semester ASC;"
   ]
  },
